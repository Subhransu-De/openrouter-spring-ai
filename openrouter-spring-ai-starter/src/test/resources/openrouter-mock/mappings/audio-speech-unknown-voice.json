{
  "name": "audio-speech-unknown-voice",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/audio/speech",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.voice == 'missing-voice')]"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "errors/400-speech-voice.json"
  }
}
