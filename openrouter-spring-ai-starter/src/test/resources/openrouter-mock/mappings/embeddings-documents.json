{
  "name": "embeddings-documents",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/embeddings",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.input[*].content[?(@.type == 'image_url')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "embeddings/documents.json"
  }
}
