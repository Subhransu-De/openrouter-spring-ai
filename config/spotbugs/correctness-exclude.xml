<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- OptionSnapshots.map preserves non-null input, including nullable values.
       SpotBugs does not interpret Spring's @Contract; NullAway and snapshot tests do. -->
  <Match>
    <Class name="de.subhransu.openrouter.springai.chat.OpenRouterChatOptions"/>
    <Method name="copyMap" params="java.util.Map" returns="java.util.Map"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>
  <!-- require(false, ...) always throws before schema is dereferenced.
       Keep strict-schema error messages and the non-strict contract unchanged. -->
  <Match>
    <Class name="de.subhransu.openrouter.springai.chat.mapper.ToolSchemaValidator"/>
    <Method name="read" params="tools.jackson.databind.ObjectMapper,org.springframework.ai.tool.definition.ToolDefinition,java.lang.Boolean" returns="tools.jackson.databind.JsonNode"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH"/>
  </Match>
</FindBugsFilter>
