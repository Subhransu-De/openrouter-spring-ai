<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="OpenRouter Spring AI main rules"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
  <description>Blocking checks for maintained library production sources.</description>
  <exclude-pattern>.*/src/test/.*</exclude-pattern>
  <exclude-pattern>.*/openrouter-spring-ai-samples/.*</exclude-pattern>

  <rule ref="category/java/design.xml/CognitiveComplexity">
    <properties>
      <property name="reportLevel" value="25"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="15"/>
      <property name="classReportLevel" value="80"/>
    </properties>
  </rule>
  <rule ref="category/java/bestpractices.xml/PreserveStackTrace"/>
  <rule ref="category/java/codestyle.xml/UnnecessaryModifier"/>

  <!-- Name-based so it also catches wrappers such as Spring's ReflectionUtils.makeAccessible
       without needing type resolution. Tests may still inspect this library's own classes. -->
  <rule name="NoAccessibilityOverride"
      language="java"
      message="Production code must not open private members; use a public contract such as OpenRouterToolFailurePolicy"
      class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
    <priority>2</priority>
    <properties>
      <property name="xpath">
        <value>
          //MethodCall[@MethodName = ('setAccessible', 'trySetAccessible', 'makeAccessible')]
        </value>
      </property>
    </properties>
  </rule>
</ruleset>
