{
  "name": "json-body",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/images",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "scenarios/images-stream-json-fallback/json-body.json"
  }
}
