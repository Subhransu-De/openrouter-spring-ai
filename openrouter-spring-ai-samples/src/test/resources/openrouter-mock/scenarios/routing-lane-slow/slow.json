{
  "name": "slow",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.sceneId == 'routing-lane')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "chat/routing-lane.json",
    "fixedDelayMilliseconds": 2500
  }
}
