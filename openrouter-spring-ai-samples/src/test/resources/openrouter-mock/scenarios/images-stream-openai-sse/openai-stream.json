{
  "name": "openai-stream",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/images",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      },
      {
        "matchesJsonPath": "$[?(@.model == 'openai/gpt-5-image-mini')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream"
    },
    "bodyFileName": "images/paint-bay-stream.sse",
    "chunkedDribbleDelay": {
      "numberOfChunks": 16,
      "totalDuration": 160
    }
  }
}
