{
  "name": "inspect",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/responses",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.sceneId == 'service-story')]"
      },
      {
        "matchesJsonPath": "$[?(@.input.size() == 1)]"
      },
      {
        "matchesJsonPath": "$.tools[?(@.name == 'inspect_vehicle_profile')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "scenarios/service-story-responses-gemini-reasoning/inspect.json"
  }
}
