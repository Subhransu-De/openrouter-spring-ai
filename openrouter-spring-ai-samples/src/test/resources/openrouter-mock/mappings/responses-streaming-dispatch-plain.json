{
  "name": "responses-streaming-dispatch-plain",
  "priority": 30,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/responses",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.sceneId == 'streaming-dispatch')]"
      },
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream"
    },
    "bodyFileName": "responses/streaming-dispatch-plain.sse"
  }
}
