{
  "name": "chat-attribution-stream",
  "priority": 29,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.sceneId == 'attribution-check-in')]"
      },
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream"
    },
    "bodyFileName": "chat/attribution.sse"
  }
}
