{
  "name": "responses-vision",
  "priority": 30,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/responses",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.input[*].content[?(@.type == 'input_image')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "responses/vision.json"
  }
}
