{
  "name": "chat-audio-output",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.suite == 'audio-output')]"
      },
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream"
    },
    "bodyFileName": "chat/audio-output.sse",
    "chunkedDribbleDelay": {
      "numberOfChunks": 8,
      "totalDuration": 80
    }
  }
}
