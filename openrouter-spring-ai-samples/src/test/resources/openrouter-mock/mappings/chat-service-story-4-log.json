{
  "name": "chat-service-story-4-log",
  "priority": 17,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.metadata.sceneId == 'service-story')]"
      },
      {
        "matchesJsonPath": "$.messages[?(@.tool_call_id == 'call_score')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "chat/chat-service-story-4-log.json"
  }
}
